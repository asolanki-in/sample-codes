# ---- LLM provider ----
# Which backend drives the agent: ollama (Ollama Cloud) or anthropic (Claude).
LLM_PROVIDER=ollama

# ---- Ollama Cloud (used when LLM_PROVIDER=ollama) ----
# Required for Ollama. Get one at https://ollama.com (Account > API keys).
OLLAMA_API_KEY=
# Hosted Ollama endpoint. Default is Ollama Cloud.
OLLAMA_HOST=https://ollama.com
# A cloud model that supports TOOL CALLING. Examples:
#   qwen3-coder:480b-cloud, gpt-oss:120b, deepseek-v3.1:671b
OLLAMA_MODEL=qwen3-coder:480b-cloud
# Max tokens per response (maps to num_predict).
OLLAMA_MAX_TOKENS=4096
# Send screenshots to Ollama. Only enable with a vision+tools capable model;
# the compact text UI snapshot is used regardless. true | false
OLLAMA_VISION=false

# ---- Anthropic / Claude (used when LLM_PROVIDER=anthropic) ----
# Required only when LLM_PROVIDER=anthropic. https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ---- appium-mcp server ----
# Transport used to talk to appium-mcp: httpStream (default) or stdio.
MCP_TRANSPORT=httpStream

# Spawn the appium-mcp server locally (true) or connect to one already running
# (false). When false, set MCP_HTTP_URL to point at the running server.
MCP_AUTOSTART=true

# httpStream connection. When autostart=true the server is launched as
#   appium-mcp --httpStream --port=<MCP_HTTP_PORT>
# and serves the streamable-HTTP endpoint at MCP_HTTP_ENDPOINT (default /sse).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
MCP_HTTP_ENDPOINT=/sse

# Full URL of an already-running httpStream server. Overrides host/port/endpoint.
# Use this with MCP_AUTOSTART=false to attach to a remote/shared server.
# MCP_HTTP_URL=http://127.0.0.1:8080/sse

# Optional JSON object of extra HTTP headers (e.g. auth) for httpStream.
# MCP_HTTP_HEADERS={"Authorization":"Bearer xxx"}

# How long (ms) to wait for the server to accept connections.
MCP_CONNECT_TIMEOUT_MS=60000

# How to launch the appium-mcp server process (used for autostart, both
# transports). The --httpStream/--port flags are appended automatically.
APPIUM_MCP_COMMAND=npx
APPIUM_MCP_ARGS=["appium-mcp@latest"]

# Run a remote/standalone Appium server instead of the embedded driver.
# Leave empty to use appium-mcp's embedded driver.
# REMOTE_SERVER_URL=http://127.0.0.1:4723

# ---- Device / platform ----
# android | ios
PLATFORM=android

# Optional: target a specific device/emulator/simulator (udid or name).
# DEVICE_NAME=emulator-5554

# Android app under test (optional - a flow can also specify these).
# APP_PACKAGE=com.example.app
# APP_ACTIVITY=.MainActivity

# iOS app under test (optional).
# BUNDLE_ID=com.example.app

# Path to a local .apk / .app / .ipa to install before the run (optional).
# APP_PATH=/absolute/path/to/app.apk

# Android SDK location (passed through to appium-mcp; required for Android).
# ANDROID_HOME=/Users/me/Library/Android/sdk

# ---- iOS (macOS only) ----
# Simulator: set DEVICE_NAME to a simulator name (e.g. "iPhone 15") and PLATFORM=ios.
# Real device: set DEVICE_NAME to the device UDID and provide signing so the
# XCUITest driver can build/sign WebDriverAgent:
# IOS_TEAM_ID=ABCDE12345              # Apple Developer team id (xcodeOrgId)
# IOS_SIGNING_ID=Apple Development    # optional (xcodeSigningId)
# WDA_BUNDLE_ID=com.yourteam.WebDriverAgentRunner  # a bundle id your team can sign
# WebDriverAgent local port (auto-incremented per device in parallel iOS runs).
# IOS_WDA_LOCAL_PORT=8100

# ---- Agent behaviour ----
# Max model<->device round trips allowed per natural-language step.
MAX_STEP_ITERATIONS=14

# Reliability (Maestro-style). SETTLE_TIMEOUT_MS = max time to wait for the UI to
# stop changing after an action; FIND_TIMEOUT_MS = implicit wait for an element
# to appear before a tap/assert fails.
SETTLE_TIMEOUT_MS=7000
FIND_TIMEOUT_MS=10000

# Send screenshots to the model (vision). Recommended. true | false
VISION_ENABLED=true

# Where screenshots / recordings from appium-mcp are written.
SCREENSHOTS_DIR=./screenshots

# debug | info | warn | error
LOG_LEVEL=info
