{
  "name": "mobile-test-agent",
  "version": "0.1.0",
  "description": "Mobile test automation agent: appium-mcp + Ollama Cloud, Maestro-style find-act-verify execution",
  "type": "module",
  "bin": {
    "mobile-test-agent": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dry-run": "tsx src/cli.ts dry-run flows/login_sample.yaml",
    "start": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fast-xml-parser": "^4.5.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
