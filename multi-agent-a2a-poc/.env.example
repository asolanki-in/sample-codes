# --- LLM backend (Ollama cloud API, or a local Ollama server) ---
# Cloud:  https://ollama.com  (get a key at https://ollama.com/settings/keys)
# Local:  set OLLAMA_HOST=http://localhost:11434 and leave OLLAMA_API_KEY empty
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your-ollama-api-key-here

# Any cloud model that supports tool calling works, e.g. gpt-oss:120b, qwen3-coder:480b
OLLAMA_MODEL=gpt-oss:120b

# --- Agent wiring (defaults shown; docker-compose overrides the URLs) ---
# MAIN_PORT=4000
# EXECUTOR_PORT=4001
# VERIFIER_PORT=4002
# EXECUTOR_URL=http://localhost:4001
# VERIFIER_URL=http://localhost:4002

# Where the .jsonl audit logs are written
# LOG_DIR=./logs
