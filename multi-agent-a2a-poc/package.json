{
  "name": "multi-agent-a2a-poc",
  "version": "1.0.0",
  "private": true,
  "description": "3-agent A2A (Agent2Agent) protocol proof-of-concept: orchestrator + executor + verifier, hand-rolled protocol layer, no agent framework SDKs.",
  "type": "module",
  "scripts": {
    "start:main": "tsx main-agent/src/index.ts",
    "start:executor": "tsx executor-agent/src/index.ts",
    "start:verifier": "tsx verifier-agent/src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
